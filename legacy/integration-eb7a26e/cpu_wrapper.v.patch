+// `a4091_dma_req` is one pulse per DMA byte beat; between the SIOP's
+// back-to-back beats it drops for a few cycles. `a4091_dma_tail` stretches
+// the "CPU off the RAM bus" window ~8 clk past each beat so a whole
+// multi-byte fetch is one uninterrupted session and the mux below does not
+// flap back to the frozen CPU's pending access mid-fetch (build #34).
+// Corruption of the *first* beat after a longer gap (SIOP waiting on a SCSI
+// phase) is handled in the SIOP d8 engine by a throwaway priming read -
+// the cpu_wrapper-side arm-delay / registered-go / ack-gate attempts
+// (builds #39-#41) all made timing or the fetch worse.
+reg  [3:0]  a4091_dma_tail;
+always @(posedge clk) begin
+	if (a4091_dma_req)         a4091_dma_tail <= 4'd8;
+	else if (|a4091_dma_tail)  a4091_dma_tail <= a4091_dma_tail - 1'b1;
+end
+wire        a4091_dma_active = a4091_dma_req | (|a4091_dma_tail);
+
+// a4091 DMA no longer masquerades as a CPU cpuCS access - it drives
+// ddram_ctrl's dedicated dma* port (see .a4091_dma* below). `ramsel` is
+// CPU-only again; the cpu_addr / cpustate mux still switches on a4091 DMA
+// so the Z3->DDR address decode (`ramaddr`) is computed for `a4091_dmaAddr`.
+assign ramsel       = (cpu_req & ~a4091_dma_active) & ~sel_nmi_vector & (sel_zram | sel_chipram | sel_kickram | sel_dd | sel_rtg);
