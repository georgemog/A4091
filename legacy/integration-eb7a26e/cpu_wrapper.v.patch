+assign a4091_dmaWR   = a4091_dma_wdata;
+assign a4091_dmaU    = uds_in;                     // active low (mux sets from bs)
+assign a4091_dmaL    = lds_in;
+
+assign a4091_sdmaCS   = a4091_dma_chip;            // edge-synced in sdram_ctrl
+assign a4091_sdmaAddr = ramaddr[24:1];             // raw Amiga addr (identity for chip)
 
