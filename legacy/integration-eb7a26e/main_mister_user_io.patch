+// ---------------------------------------------------------------------------
+// A4091 SCSI sector server (option 1 prototype) -- MOUNT-ONLY isolation build.
+// Mount the .hdf on sd_image[A4091_SD_SLOT] so the core sees img_mounted /
+// present=1. hps_ext polling (cmd 0x64/0x68) is disabled here on purpose.
+// ---------------------------------------------------------------------------
+#define A4091_SD_SLOT 0
+
+static void a4log(const char *fmt, ...)
+{
+	static FILE *lf = NULL;
+	static int   tried = 0;
+	if (!lf && !tried)
+	{
+		tried = 1;
+		lf = fopen("/media/usb0/a4091_sd.log", "w");
+		if (lf) { setvbuf(lf, NULL, _IOLBF, 0); fprintf(lf, "--- a4091_sd log start ---\n"); }
+	}
+	if (!lf) return;
+	va_list ap; va_start(ap, fmt);
+	vfprintf(lf, fmt, ap);
+	va_end(ap);
+	fflush(lf);
+}
+
+static void a4091_sd_poll()
+{
+	// The core's a4091_sd latches img_present / disk_blocks on the
+	// img_mounted strobe. One mount at the first poll races the FPGA reset
+	// that follows load_core and is lost -> present=0 -> every SCSI SELECT
+	// times out. So open the file once, then re-strobe UIO_SET_SDSTAT on a
+	// schedule for the first ~20 s until the core is definitely out of reset.
+	static uint32_t polls = 0;
+	static int      opened = 0;
+	static int      remounts = 0;
+	fileTYPE *f = &sd_image[A4091_SD_SLOT];
+
+	polls++;
+	if (polls & 0x3f) return;   // throttle: run the body ~every 64th call
+
+	if (!opened)
+	{
+		opened = 1;
+		a4log("slot %d  size=%llu  path=\"%s\"\n",
+		      A4091_SD_SLOT, (unsigned long long)f->size,
+		      f->size ? f->name : "(none)");
+		if (!f->size)
+		{
+			static const char *cand[] = {
+				"A4091/a4091test.hdf",
+				"/media/fat/A4091/a4091test.hdf",
+				"../usb0/games/Amiga/shared/a4091/a4091test.hdf", 0 };
+			for (int i = 0; cand[i]; i++)
+			{
+				int r = user_io_file_mount(cand[i], A4091_SD_SLOT);
+				a4log("  try mount \"%s\" -> ret=%d size=%llu\n",
+				      cand[i], r, (unsigned long long)f->size);
+				if (f->size) break;
+			}
+		}
+	}
+
+	// Re-issue the full mount notify (size then mount strobe) every ~2 s for
+	// the first ~2 min. The core's a4091_sd only latches the strobe while it
+	// is out of reset, which does not happen until AmigaOS has finished
+	// booting - well after the one mount at startup.
+	if (f->size && (polls & 0x3fff) == 0)
+	{
+		remounts++;
+		EnableIO();
+		spi8(UIO_SET_SDINFO);
+		if (io_ver) { spi32_w(f->size); spi32_w(f->size >> 32); }
+		else        { spi32_b(f->size); spi32_b(f->size >> 32); }
+		DisableIO();
+		spi_uio_cmd8(UIO_SET_SDSTAT, (1 << A4091_SD_SLOT) | 0x80);
+		if (remounts <= 8 || (remounts & 63) == 0) a4log("  re-mount %d @ poll %u\n", remounts, polls);
+	}
+
+	// ---- hps_ext sector mailbox: 0x64 poll / 0x65 HPS->FPGA / 0x66 FPGA->HPS
+	//      / 0x67 block done. Serve one 512 B block per poll from the .hdf.
+	{
+		static uint8_t  a4buf[512];
+		static uint32_t reqs = 0;
+
+		EnableIO();
+		// hps_ext presents the 0x64 status on the SAME word that carries the
+		// command (like UIO_DMA_SDIO / ide_check), NOT the next word.
+		uint16_t st  = spi_w(0x0064);          // {14'b0, wr_pending, rd_pending}
+		uint16_t l0  = spi_w(0);               // lba[15:0]
+		uint16_t l1  = spi_w(0);               // lba[31:16]
+		DisableIO();
+		uint32_t lba = l0 | ((uint32_t)l1 << 16);
+		if (!(st & 3)) return;
+
+		reqs++;
+		uint64_t nblk    = f->size >> 9;
+		int      is_wr   = (st & 2) ? 1 : 0;
+		int      inrange = (f->size && lba < nblk);
+		int      verbose = (reqs <= 40) || ((reqs & 255) == 0);
+
+		if (verbose)
+			a4log("req #%u %s lba=%u nblk=%llu %s\n", reqs, is_wr ? "WR" : "RD",
+			      lba, (unsigned long long)nblk, inrange ? "" : "OUT-OF-RANGE");
+
+		if (is_wr)
+		{
+			EnableIO();
+			spi_w(0x0066);
+			spi_w(0);                        // pipeline fill throwaway
+			for (int i = 0; i < 512; i++) a4buf[i] = (uint8_t)spi_w(0);
+			DisableIO();
+			if (inrange && FileSeek(f, (__off64_t)lba << 9, SEEK_SET))
+			{
+				diskled_on();
+				int n = FileWriteAdv(f, a4buf, 512);
+				if (verbose) a4log("  FileWriteAdv -> %d\n", n);
+			}
+			else if (verbose) a4log("  WR skipped (range/seek)\n");
+		}
+		else
+		{
+			memset(a4buf, 0, sizeof(a4buf));
+			if (inrange && FileSeek(f, (__off64_t)lba << 9, SEEK_SET))
+			{
+				diskled_on();
+				int n = FileReadAdv(f, a4buf, 512);
+				if (verbose) a4log("  FileReadAdv -> %d  data[0..7] %02x %02x %02x %02x %02x %02x %02x %02x\n",
+				      n, a4buf[0],a4buf[1],a4buf[2],a4buf[3],a4buf[4],a4buf[5],a4buf[6],a4buf[7]);
+			}
+			else if (verbose) a4log("  RD zero-fill (range/seek)\n");
+			EnableIO();
+			spi_w(0x0065);
+			for (int i = 0; i < 512; i++) spi_w(a4buf[i]);
+			DisableIO();
+		}
+
+		EnableIO();
+		spi_w(0x0067);                       // pulse blk_done
+		DisableIO();
+	}
+}
+
