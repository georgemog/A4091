@@ -539,6 +539,21 @@ sd_readwrite(void *periph_p, uint64_t blkno, uint b_flags, void *buf,
     struct scsipi_xfer *xs;
     uint32_t blkshift = periph->periph_blkshift;
     uint32_t nblks = buflen >> blkshift;
+
+    /*
+     * Software-SIOP C1 target buffer grows on demand, so this is a
+     * throughput knob, not a correctness cap: fewer, larger SCSI
+     * commands amortise the per-DATA-IN mm_ramctrl_cache_evict() sweep.
+     * 128 KB verified: regression 10/10 + a 4x 3.3 MB LhA copy/CRC on a
+     * filling (fragmenting) disk, all clean. A contiguous buffer is 1-2
+     * S/G segments; the datain SCRIPTS have 9. sd_complete /
+     * chan_continue_iotd re-issues anything past MM_MAX_XFER.
+     */
+#define MM_MAX_XFER 131072u
+    if (buflen > MM_MAX_XFER) {
+        buflen = MM_MAX_XFER & ~((1u << blkshift) - 1u);
+        nblks  = buflen >> blkshift;
+    }
     int cmdlen;
     int flags;
 
