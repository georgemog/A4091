@@ -539,6 +539,23 @@ sd_readwrite(void *periph_p, uint64_t blkno, uint b_flags, void *buf,
     struct scsipi_xfer *xs;
     uint32_t blkshift = periph->periph_blkshift;
     uint32_t nblks = buflen >> blkshift;
+
+    /*
+     * a4091_target's dbuf is 16 KB (BUFAW 14). The transfer protocol is
+     * strictly sequential - a4091_sd fills dbuf, then the SIOP drains it -
+     * so any transfer larger than dbuf wraps the fill pointer and desyncs
+     * the sec_done handshake: phase mismatch -> bus reset -> HDToolBox
+     * "I/O error code 48". Cap every transfer at 16 KB here; the
+     * sd_complete / chan_continue_iotd path re-issues the remainder.
+     *
+     * (A concurrent producer/consumer ring that would remove this cap was
+     * tried and reverted - see A4091/JOURNAL.md 20260904.)
+     */
+#define MM_MAX_XFER 16384u
+    if (buflen > MM_MAX_XFER) {
+        buflen = MM_MAX_XFER & ~((1u << blkshift) - 1u);
+        nblks  = buflen >> blkshift;
+    }
     int cmdlen;
     int flags;
 
