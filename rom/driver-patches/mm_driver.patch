diff --git a/siop.c b/siop.c
index f2083f7..ad250c6 100644
--- a/siop.c
+++ b/siop.c
@@ -480,6 +480,63 @@ siop_sched(struct siop_softc *sc)
     siop_select(sc);
 }
 
+
+#ifdef PORT_AMIGA
+/*
+ * Minimig / FPGA core coherency workaround.
+ *
+ * The Minimig-AGA RAM controller (cpu_cache_new) is a look-through read
+ * cache in FRONT of RAM and does NOT snoop the a4091 bus-master DMA port.
+ * After a DATA-IN transfer the CPU's cached copy of the DMA buffer is
+ * stale. There are two independent cache instances - one for chip RAM
+ * (sdram_ctrl) and one for fast RAM (ddram_ctrl) - so both must be
+ * thrashed. fx68k has no CPU cache, so CacheClearE / CachePostDMA cannot
+ * reach this.
+ *
+ * Walk a scratch arena larger than the cache in each of chip and fast RAM;
+ * a linear sweep with an 8-byte stride (one touch per line) evicts every
+ * set regardless of where the DMA buffer landed.
+ */
+#define MM_EVICT_SIZE 32768
+static unsigned char *mm_evict_fast;
+static unsigned char *mm_evict_chip;
+static volatile unsigned long mm_evict_sink;
+
+static void
+mm_ramctrl_cache_evict(void)
+{
+    volatile unsigned char *q;
+    unsigned long i, acc = 0;
+
+    /*
+     * TG68 "020" on this MiSTer core DOES forward the 68020 CACR clear bit
+     * to cpu_cache_new (cpu_cache_ctrl[3] -> cpu_cache_clear, an edge on the
+     * CACR clear bit wipes BOTH the chip (sdram_ctrl) and fast (ddram_ctrl)
+     * cache instances). CacheClearU() issues exactly that, so it is a single
+     * unconditional flush of every a4091-DMA-stale line - much more reliable
+     * than the scratch sweep, which needs the arena to land in the same bank
+     * as the DMA buffer and only converges after several passes.
+     */
+    CacheClearU();
+
+    /* Separate checks + no re-assign: at init() time (ROM mounter) there is
+     * no FAST RAM yet, so the FAST alloc fails - but the mounter reads into
+     * CHIP RAM then, and the CHIP arena still evicts those lines. Retry the
+     * FAST alloc on later calls once expansion has added the RAM board. */
+    if (mm_evict_chip == NULL)
+        mm_evict_chip = AllocMem(MM_EVICT_SIZE, MEMF_CHIP | MEMF_PUBLIC);
+    if (mm_evict_fast == NULL)
+        mm_evict_fast = AllocMem(MM_EVICT_SIZE, MEMF_FAST | MEMF_PUBLIC);
+    if ((q = mm_evict_chip) != NULL)
+        for (i = 0; i < MM_EVICT_SIZE; i += 8)
+            acc += q[i];
+    if ((q = mm_evict_fast) != NULL)
+        for (i = 0; i < MM_EVICT_SIZE; i += 8)
+            acc += q[i];
+    mm_evict_sink = acc;
+}
+#endif
+
 void
 siop_scsidone(struct siop_acb *acb, int stat)
 {
@@ -566,6 +623,8 @@ siop_scsidone(struct siop_acb *acb, int stat)
      */
     if (acb->iob_buf != NULL && acb->iob_len != 0) {
         CachePostDMA(&acb->iob_buf, (LONG *)&acb->iob_len, 0);
+        if (xs->xs_control & XS_CTL_DATA_IN)
+            mm_ramctrl_cache_evict();
     }
 #endif
 
@@ -1270,6 +1329,19 @@ siop_checkintr(struct siop_softc *sc, u_char istat, u_char dstat,
     int dfifo, dbc, sstat1;
     (void)istat;
 
+#ifdef PORT_AMIGA
+    /*
+     * STATUS and MSG IN are DMA'd into acb->stat[0] / acb->msg[0] by the
+     * SIOP, and the Minimig RAM controller's read cache does not snoop that
+     * DMA. siop_scsidone() flushes via mm_ramctrl_cache_evict(), but that
+     * runs AFTER this routine has already read acb->stat[0]/msg[0] - on a
